<div class="input-group mt-3">
  <% begin %>
    <% parsed = JSON.parse(log) %>
    <div class="ms-3 mt-1 w-100 fw-bolder">
      <%= DateTime.parse(parsed["timestamp"]).strftime("%d/%m/%Y @ %H:%M") + ", by " + parsed["username"] %>
      <% parsed["changes"].each do |change| %>
        <div class="ms-3 mt-1 w-100 fw-lighter"><%= change %></div>
      <% end %>
    </div>
  <% rescue JSON::ParserError %>
    <!-- skip or show raw log -->
    <div class="text-danger">Invalid log format</div>
  <% end %>
</div>
