$(".modal").modal('hide');
$('#content').html("<%= j render 'setup', game: @game %>");
$('#gameModal').modal('show');

$('#step-users').click(function() {
  const selectedFactionIds = $('.checkbox-faction:checked').map(function() {
      return parseInt(this.value, 10);
  }).get();

  $('.select-factions').find('option').each(function() {
    const optionValue = parseInt($(this).val(), 10);

    if (!selectedFactionIds.includes(optionValue)) {
      $(this).hide();
    }
  });

  $('.select-factions').selectpicker('refresh');
  $("#users-tab").tab("show");
});

$('#step-tools').click(function() {
  $("#tools-tab").tab("show");
});

$('#step-complete').click(function() {
  $("#complete-tab").tab("show");
});

$('input[type="checkbox"]').change(function() {
  var id = $(this).attr('id').split("-")[1]
  if ($(this).prop('checked')) {
    $('#' + id).removeClass("inactive")
    $('#users_' + id.split("_")[1] + '_faction').prop('disabled', false)
    $('#users_' + id.split("_")[1] + '_faction').selectpicker('refresh')
  } else {
    $('#' + id).addClass("inactive")
    $('#users_' + id.split("_")[1] + '_faction').prop('disabled', true)
    $('#users_' + id.split("_")[1] + '_faction').selectpicker('refresh')
  }
});
